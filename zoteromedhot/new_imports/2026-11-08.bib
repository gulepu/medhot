@article{zm2026_httpsdoiorg1002mds_0,
  title = {Optimizing Genetic Analyses for Movement Disorders: A Unified Panel Approach and Targeted Reanalysis of 4,046 Clinical Exomes},
  author = {Barbarii Teodora and Smeekens Sanne P. and Pennings Maartje and Astuti Galuh and Vissers Lisenka E.L.M. and Yntema Helger G. and Gilissen Christian and Warrenburg Bart P.C. van de and Kamsteeg Erik‐Jan},
  journal = {Movement Disorders},
  year = {2026},
  doi = {https://doi.org/10.1002/mds.70563},
  url = {https://doi.org/https://doi.org/10.1002/mds.70563},
  abstract = {BACKGROUND: Molecular testing for genetic movement disorders (MDs) increasingly relies on exome- or genome-based virtual gene panels. In the absence of consensus guidelines, MD panel design remains heterogeneous across laboratories, with international variation in panel configuration and gene content. OBJECTIVE: The aim of this work was to develop a reproducible framework for a unified MD panel design, generate a comprehensive, curated gene-phenotype dataset, and evaluate clinical utility via targeted exome reanalysis. METHODS: Candidate genes were extracted from multiple resources and assessed using predefined criteria for panel inclusion and gene-disease validity. Genes were tiered as Green, Amber, or Red based on evidence strength. Phenotypic spectrum and age at onset were assessed for Green genes based on published literature. Newly added Green and Amber genes were investigated in 4,046 exomes from previously undiagnosed MD cases. RESULTS: Among 2,090 extracted genes, 640 were selected. The final panel included 537 Green, 36 Amber, and 67 Red genes, expanding the prior panel by 283 genes and removing 42. Across Green genes, only 17% were linked to a single MD feature, whereas the remainder associated up to eight. Age-at-onset data indicated both pediatric and adult presentations in 43% of genes. Targeted exome reanalysis using a 220-gene list identified 37 clinically relevant variants across 28 genes, resolving 16 cases and increasing diagnostic yield by 0.4%. CONCLUSIONS: This study offers a systematic framework for designing a unified MD panel by integrating evidence from multiple sources and accounting for phenotypic and age heterogeneity. Targeted reanalysis yielded actionable diagnoses, confirming its benefit in routine clinical practice. © 2026 The Author(s). Movement Disorders published by Wiley Periodicals LLC on behalf of International Parkinson and Movement Disorder Society.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「库根」}
}
@article{zm2026_httpsdoiorg1002mds_1,
  title = {Skin Seed Amplification Assay Differentiates Multiple System Atrophy from Parkinson's Disease},
  author = {Kuzkina Anastasia and Rodríguez-Gomez Diego Alejandro and Panzer Celine and Ndayisaba Alain and Kohl Antonia and Rai Shreya and Gilbert Breelyn and Hammerschlag Bruno and Shen Karie and Rauschenberger Lisa and Laun Olivia and Meehan Julia and Perumalla Sucika and Salabasidou Elena and Jones Kristie and Ceku Dalina and Blum Robert and Knörr Susanne and Monoranu Camelia M. and Sommer Claudia},
  journal = {Movement Disorders},
  year = {2026},
  doi = {https://doi.org/10.1002/mds.70573},
  url = {https://doi.org/https://doi.org/10.1002/mds.70573},
  abstract = {Abstract Background Misdiagnoses of multiple system atrophy (MSA) and Parkinson’s disease (PD) remain common due to overlapping clinical features. Objective To develop and assess a skin α-synuclein seed amplification assay (αSyn-SAA) for detecting pathological α-synuclein and distinguishing MSA from PD. Methods In this blinded, cross-sectional study conducted across two laboratories, 308 skin biopsies from 117 participants were analyzed using a standardized αSyn-SAA protocol. The cohort included 42 PD, 31 MSA, 30 controls, and 14 with progressive supranuclear palsy (PSP). Biopsies were obtained from up to four anatomical sites and positivity was defined as ≥75% positive replicates. Kinetic parameters were analyzed to differentiate PD and MSA, and clinical features were correlated with αSyn-SAA positivity. Fibril morphology from amplified skin samples was compared to postmortem brain using proteinase K digestion and electron microscopy. Results αSyn-SAA detected synucleinopathy in 86% of PD and 77% of MSA patients, with 90% specificity versus controls and 86% versus PSP. ROC analysis showed that maximum fluorescence (Fmax, AUC = 0.93) and lag time (AUC = 0.91) distinguished PD from MSA at the biopsy level. A 50% mean Fmax cutoff across positive samples accurately differentiated synucleinopathies with 90% sensitivity and 85% specificity. αSyn-SAA positivity correlated with RBD in both disorders and with autonomic features in MSA. Amplified fibrils displayed distinct structural and proteolytic profiles between PD and MSA, consistent with brain-derived aggregates. Conclusion Skin αSyn-SAA detects pathological α-synuclein in living patients with high accuracy and distinguishes MSA from PD based on assay kinetics and fibril strain properties.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「PD」}
}
@article{zm2026_httpsdoiorg1021acs_2,
  title = {Multi-Omics Gut Microbiome Species Communities and Functional Modules Linking Metal Exposures to Children’s Neurodevelopmental Health in a Canadian Birth Cohort},
  author = {Zhang Yidan and Shen Yike and Fan Yihan and Gagnon Anthony and Gillet Virginie and Posner Jonathan E. and Bellenger Jean‐Philippe and Baccarelli Andrea and Takser Larissa and Gao Feng},
  journal = {Environmental Science \& Technology},
  year = {2026},
  doi = {https://doi.org/10.1021/acs.est.6c07743},
  url = {https://doi.org/https://doi.org/10.1021/acs.est.6c07743},
  abstract = {Abstract Early life metal exposure has been associated with adverse neurodevelopment, with gut microbiome disruption proposed as a potential pathway. However, most studies have focused on individual taxa or pathways, despite microbes functioning within ecological communities and coordinated functional networks. Here, we integrated stool metal measurements, shotgun metagenomics, metatranscriptomics, and neurodevelopmental assessments in 116 children aged 8–12 years from the GESTE birth cohort in Sherbrooke, Canada. Nineteen metals were quantified in stool samples, and neurodevelopment was assessed using parent-reported behavioral scales, attention performance testing, and resting-state fMRI. Using network-based community detection, we identified 10 co-occurring species communities (SCs) from metagenomic data and 16 coexpressed functional modules (FMs) from metatranscriptomic data and evaluated their associations with metal exposures and neurodevelopmental outcomes. Higher levels of lead, cadmium, aluminum, zinc, copper, and magnesium were associated with lower abundance of Streptococcus- and Veillonella-dominated SCs, while multiple metals were associated with lower abundance of amino acid metabolism and carbohydrate degradation FMs. Exploratory mediation analyses suggested potential indirect associations between stool metals and parent-reported ADHD-related traits througha methionine cycle-related FM or sequentially through a Clostridium spp. SC and a Factor 420 biosynthesis FM. These findings suggest that stool metal concentrations are associated with community-level variations in gut microbial composition and function, some of which were further associated with parent-reported ADHD-related traits.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「肌张力障碍」}
}
@article{zm2026_httpsdoiorg1111ejn_3,
  title = {Time to Move Upstream? A Framework for Expanding the Focus of Freezing of Gait to Prodromal, Subclinical, and Pre‐FOG Stages},
  author = {Hausdorff Jeffrey M. and Martens Kaylena A. Ehgoetz and Gilat Moran and Nonnekes Jorik H. and Mancini Martina and McKay J. Lucas and Ginis Pieter and Adams Jamie and Mammen Jennifer R. and Howe Erika E. and Lewis Simon L. and Horak Fay Bahling and Nieuwboer Alice},
  journal = {European Journal of Neuroscience},
  year = {2026},
  doi = {https://doi.org/10.1111/ejn.70721},
  url = {https://doi.org/https://doi.org/10.1111/ejn.70721},
  abstract = {Freezing of gait (FOG) is one of the most disabling motor symptoms of Parkinson's disease, yet a fundamental question remains unresolved: why does FOG occur at any given moment? Most research has focused on studying FOG once it is already manifest. The present work aims to synthesize recent observations and propose a conceptual framework in which FOG reflects a dynamic process unfolding across multiple stages and time scales. Subtle changes in gait dynamics and physiology can precede episodes by several seconds (Stage -1), and experimental paradigms show that individuals without clinically recognized freezing may exhibit brief episodes under sufficiently sensitive conditions (Stage -2). At longer time scales, prospective studies indicate that vulnerability to freezing may be detectable years before onset (Stage -3). This framework reflects the idea that FOG emerges from progressive instability across interacting motor, cognitive, autonomic, and environmental systems, rather than as an isolated event. The proposed framework includes a prodromal stage, a subclinical stage, an immediate prefreezing state, and the freezing episode itself (Stage 0). This framework integrates findings from wearable sensing, physiology, and clinical studies and emphasizes that FOG remains latent in Stage -3, may be elicited only under specific conditions in Stage -2, and becomes manifest as instability evolves toward imminent and overt freezing (Stages -1 and 0, respectively). Reframing FOG as a multistage process that includes an upstream phase raises new questions regarding mechanisms, classification, and intervention, and may, ultimately, inform strategies aimed at predicting and preventing freezing rather than simply reacting to it.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「库根」}
}
@article{zm2026_httpsdoiorg3389fmo_4,
  title = {A cuproptosis-related gene signature and the protective role of CDKN1A in sepsis-induced acute respiratory distress syndrome},
  author = {Liu Yue and Wang Ni and Chang Wei and Xu Jingyuan and Guo Fengmei},
  journal = {Frontiers in Molecular Biosciences},
  year = {2026},
  doi = {https://doi.org/10.3389/fmolb.2026.1962671},
  url = {https://doi.org/https://doi.org/10.3389/fmolb.2026.1962671},
  abstract = {Background Sepsis-induced acute respiratory distress syndrome (ARDS) is associated with high mortality, and reliable molecular biomarkers remain limited. This study aimed to identify candidate cuproptosis-related diagnostic biomarkers and investigate the protective role of CDKN1A. Methods Differentially expressed genes from GSE10474 were intersected with cuproptosis-related genes, followed by functional enrichment, protein–protein interaction analysis, and machine learning using LASSO, random forest, and support vector machine algorithms. The resulting signature was evaluated in GSE32707 and GSE66890. Immune infiltration and single-cell transcriptomic analyses were performed, followed by experimental evaluation of CDKN1A overexpression in LPS-stimulated alveolar epithelial cells. Results An eight-gene signature comprising CDKN1A, MNDA, TREM1, ACP6, APOO, CHPT1, PIAS3, and SNRNP35 was identified. The models achieved AUCs of 0.786–0.886 in the training cohort and 0.654–0.745 in the validation cohorts. Immune analyses revealed dataset-dependent alterations in immune cell populations. CDKN1A overexpression attenuated LPS-induced cytotoxicity, improved cell viability and tight junction protein expression, modulated cuproptosis-related markers, reduced intracellular copper and mitochondrial reactive oxygen species, and preserved mitochondrial membrane potential. Conclusion The eight-gene signature represents a candidate diagnostic tool for sepsis-induced ARDS. CDKN1A overexpression is associated with protection against LPS-induced alveolar epithelial injury and modulation of cuproptosis-related and mitochondrial markers. Further mechanistic and prospective clinical validation is required.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「库根」}
}
@article{zm2026_httpsdoiorg3389fna_5,
  title = {Preserved olfaction unmasks choroid plexus–related cognitive risk in Parkinson’s disease},
  author = {He Shuang and Jiao Yu-xiang and Pei-wen Han and Zhang Haohan and Ma Kai and Wang Xijin and Zhang Jiewen and Chen Shuai},
  journal = {Frontiers in Aging Neuroscience},
  year = {2026},
  doi = {https://doi.org/10.3389/fnagi.2026.1954812},
  url = {https://doi.org/https://doi.org/10.3389/fnagi.2026.1954812},
  abstract = {Background Choroid plexus volume (CPV) has been associated with cognitive impairment in Parkinson’s disease (PD), particularly frontal-executive dysfunction, whereas olfactory dysfunction is linked to cognitive deterioration and may reflect greater α-synuclein involvement. Whether olfactory status modifies the association between CPV and cognitive outcomes remains unclear. Methods We analyzed 718 participants with early-stage PD followed for up to 10 years. Baseline CPV was derived from structural MRI. Hyposmia was defined as an age- and sex-adjusted University of Pennsylvania Smell Identification Test percentile ≤ 15. Kaplan–Meier and multivariable Cox models were used to examine incident cognitive milestone (CogM), including a CPV × olfactory status interaction. CPV was standardized to 1-SD units. Multiple sensitivity analyses assessed robustness. Results Among 709 participants with olfactory data, 502 (70.8%) had hyposmia. Ten-year CogM-free survival was 59.4%. The primary Cox analysis included 680 participants and 173 CogM events. Among participants with normosmia, each 1-SD increase in CPV was associated with higher CogM risk (HR = 1.63, 95% CI 1.20–2.22, P = 0.002). Hyposmia was associated with higher CogM risk at the mean CPV level (HR = 1.91, 95% CI 1.23–2.97, P = 0.004). The CPV × hyposmia interaction was significant (HR = 0.62, 95% CI 0.43–0.88, P = 0.008); the CPV association was absent in participants with hyposmia (HR = 1.01, 95% CI 0.83–1.22, P = 0.950). Findings were consistent across sensitivity analyses. Conclusion Olfactory status modified the association between CPV and cognitive outcomes in early PD. Larger CPV was associated with higher CogM risk in participants with preserved olfaction, but not in those with hyposmia. These findings warrant validation in independent cohorts.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「PD」}
}
@article{zm2026_httpsdoiorg3390ijm_6,
  title = {One Disorder, Two Brains: Challenges in Modeling Epilepsy and Associated Movement Disorders in Mice},
  author = {Travin Daniil I. and Anisimova Polina E. and Bogovarova Ksenia A. and Kustova Angelina O. and Tarabykin Victor S.},
  journal = {International Journal of Molecular Sciences},
  year = {2026},
  doi = {https://doi.org/10.3390/ijms27219916},
  url = {https://doi.org/https://doi.org/10.3390/ijms27219916},
  abstract = {Modeling epileptic syndromes co-occurring with movement disorders in mice often fails to fully recapitulate human phenotypes due to distinct gene-specific and anatomical mechanisms. This review categorizes these translational barriers into three primary groups. First, ortholog heterotopia and heterochrony drive spatiotemporal shifts in gene expression, causing orthologs to activate at disparate developmental stages or within different cell populations across species. Second, molecular redundancy and compensation obscure phenotypes through the upregulation of alternative proteins in response to target protein suppression, the activation of modifier genes, or neural network rewiring. Third, structural variations in striatal anatomy fundamentally alter corticostriatal loop functioning. Characterizing these divergent mechanisms is essential for improving the predictive validity of preclinical models and advancing targeted therapies.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「癫痫」}
}
@article{zm2026_httpsdoiorg1080002_7,
  title = {Salidroside alleviates MPP + -induced injury and mitochondrial fission in PC12 cells by mediating the HDAC6/MST1/MIEF1 axis},
  author = {Zhao Ruixiang and Chen Lifang and Li Xin and Mao Xue and Zhou Yanli and Shen Jun},
  journal = {International Journal of Neuroscience},
  year = {2026},
  doi = {https://doi.org/10.1080/00207454.2026.2758257},
  url = {https://doi.org/https://doi.org/10.1080/00207454.2026.2758257},
  abstract = {Parkinson’s disease (PD) is a progressive neurodegenerative disorder marked by the loss of dopaminergic neurons and impaired mitochondrial dynamics. Salidroside (SAL), a natural compound extracted from Rhodiola rosea, possesses antioxidative and anti-inflammatory properties, yet its role in regulating mitochondrial fission via specific molecular pathways in PD remains unclear. This study investigates the protective effects of SAL against MPP+-induced injury in PC12 cells and examines its mechanistic involvement in the HDAC6/MST1/MIEF1 axis. Using an MPP+-exposed PC12 cell model of PD-related cellular injury, we demonstrated that SAL treatment significantly restored cell viability, reduced Hoechst 33258-detected apoptotic nuclear changes, and reduced the concentrations of inflammatory cytokines in culture supernatants (IL-1β, IL-6, TNF-α). Furthermore, SAL attenuated oxidative stress by decreasing ROS and MDA levels while enhancing SOD activity. Importantly, SAL ameliorated mitochondrial dysfunction by improving membrane potential, increasing ATP production, and inhibiting fission protein expression (Drp1, Fis1, Mff). Mechanistic analyses revealed that SAL enhances HDAC6 promoter activity and increases HDAC6 protein expression; HDAC6 subsequently interacts with MST1 and regulates its acetylation status, while SAL treatment is associated with reduced MST1 and MIEF1 expression and suppression of mitochondrial fission signaling. The protective effects of SAL were nullified upon HDAC6 knockdown or overexpression of MST1/MIEF1, supporting the involvement of this signaling pathway in the protective effects of SAL. In conclusion, SAL mitigates MPP+-induced mitochondrial fission and cellular injury in PC12 cells through an HDAC6-dependent mechanism involving the MST1/MIEF1 axis, supporting further investigation of this pathway in more physiologically relevant PD models.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「库根」}
}
@article{zm2026_httpsdoiorg3390bra_8,
  title = {Multimodal Imaging and Molecular Biomarkers of Co-Pathology Across the Parkinson’s Disease–Dementia with Lewy Bodies Continuum},
  author = {Mascioli Davide and Conti Matteo and Schirinzi Tommaso and Stefani Alessandro},
  journal = {Brain Sciences},
  year = {2026},
  doi = {https://doi.org/10.3390/brainsci16111204},
  url = {https://doi.org/https://doi.org/10.3390/brainsci16111204},
  abstract = {Parkinson’s disease (PD) and dementia with Lewy bodies (DLB) are increasingly viewed as regions of a single α-synuclein continuum rather than separate entities. Neuropathology shows that Lewy pathology rarely occurs alone: Alzheimer-type amyloid-β and tau, transactive response DNA-binding protein 43 kDa (TDP-43) inclusions, and cerebrovascular lesions accompany it as the rule rather than the exception, and this co-pathology contributes to the clinical heterogeneity observed across the continuum without mapping onto its clinical divisions. The open problem is no longer whether co-pathology matters but how to measure it in living patients and integrate that information for individualized care. This review is organized by proteinopathy (α-synuclein as the primary lesion, then amyloid-β, tau, and TDP-43/vascular co-pathology) and, within each, follows the modalities that interrogate it: molecular imaging, fluid and tissue biomarkers, and their downstream structural, metabolic, functional, and electrophysiological correlates. No single technique captures the co-pathological landscape. Profiling an individual’s proteinopathy burden in vivo requires a deliberate combination of methods, and precision management of the PD–DLB continuum depends on this multimodal integration.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「PD」}
}
@article{zm2026_httpsdoiorg3389fna_9,
  title = {Disulfidptosis in neurological disorders: from disulfide stress to actin cytoskeletal collapse},
  author = {Qi Changbo and Gu Yaodong and Lei Jun and Jiang Lifang and Li Jiawei and Bai Bokai and Jiang Xicheng},
  journal = {Frontiers in Aging Neuroscience},
  year = {2026},
  doi = {https://doi.org/10.3389/fnagi.2026.2003656},
  url = {https://doi.org/https://doi.org/10.3389/fnagi.2026.2003656},
  abstract = {The mechanisms driving irreversible neural cell loss in neurodegenerative diseases remain elusive. The collapse of cellular redox balance has unveiled a complex network of emerging metabolic cell death modalities that extend far beyond classical apoptosis. Disulfidptosis, a newly identified form of regulated cell death driven by disulfide stress and uniquely marked by actin cytoskeletal collapse, adds a critical dimension to this network. This review establishes an integrative framework—from sulfur metabolic imbalance to cytoskeletal collapse—for understanding this lethal pathway specifically within the nervous system. we focus on three features that are distinctive to neural tissue: the neuron–glia metabolic coupling that dictates which cell type is most vulnerable; the contrast between chronic disulfide stress dynamics in neurodegeneration and acute stress dynamics in ischemic stroke; and the blood–brain barrier (BBB) and cellular heterogeneity constraints that shape translational strategies. We first establish the cystine/cysteine cycle as the central hub of sulfur metabolism, revealing how it transforms from an antioxidant defense into a lethal driver of disulfide stress upon crossing a critical threshold. We then systematically dissect the molecular machinery of disulfidptosis, centered on NADPH depletion, the SLC7A11 bidirectional paradox, and aberrant cytoskeletal crosslinking. By systematically comparing disulfidptosis with ferroptosis and cuproptosis, we identify the SLC7A11-cystine-NADPH axis as a shared regulatory node. We further discuss how this mechanism may converge to contribute to neural cell injury across chronic neurodegenerative and acute neurological conditions, including Alzheimer’s disease and Parkinson’s disease, and may also extend to acute neurological conditions such as ischemic stroke. Finally, we propose a dual neuroprotective strategy targeting disulfidptosis and highlight its biomarker potential. Collectively, this review offers a new paradigm for understanding metabolic cell death in neurodegenerative diseases and lays a theoretical foundation for neuroprotective strategies targeting disulfide homeostasis.},
  note = {ZoteroMedHOT 新施用文献 · 建议放入收藏「库根」}
}
